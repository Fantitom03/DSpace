<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE input-forms SYSTEM "submission-forms.dtd">

<input-forms>

  <form-definitions>

    <!-- FORMULARIO PASO 1 (Ex Página 1) REQUERIDO POR DSPACE 8 item-submission.xml -->
    <form name="traditionalpageone">

      <!-- Título -->
      <row>
        <field>
          <dc-schema>dc</dc-schema>
          <dc-element>title</dc-element>
          <dc-qualifier></dc-qualifier>
          <repeatable>false</repeatable>
          <label>Título</label>
          <input-type>onebox</input-type>
          <hint>Campo obligatorio. Ingresar Titulo de la producción.</hint>
          <required>Debe ingresar el título de la producción.</required>
        </field>
      </row>

      <!-- Autores / Creadores -->
      <row>
        <field>
          <dc-schema>dc</dc-schema>
          <dc-element>contributor</dc-element>
          <dc-qualifier>author</dc-qualifier>
          <repeatable>true</repeatable>
          <label>Creador (o autor)/ Responsables o Firmantes</label>
          <input-type>name</input-type>
          <hint>Campo obligatorio. Ingresar nombre de los autores de la producción.</hint>
          <required>Debe ingresar al menos un autor.</required>
        </field>
      </row>

      <!-- Palabras Clave -->
      <row>
        <field>
          <dc-schema>dc</dc-schema>
          <dc-element>subject</dc-element>
          <repeatable>true</repeatable>
          <label>Palabras Clave</label>
          <input-type>onebox</input-type>
          <hint>Campo obligatorio si lo tiene el documento. Ingresar las palabras clave, al menos 3.</hint>
          <required></required>
        </field>
      </row>

      <!-- Resumen -->
      <row>
        <field>
          <dc-schema>dc</dc-schema>
          <dc-element>description</dc-element>
          <dc-qualifier>abstract</dc-qualifier>
          <repeatable>false</repeatable>
          <label>Resumen</label>
          <input-type>textarea</input-type>
          <hint>Campo obligatorio si lo tiene el documento. Ingresar el resumen de la producción.</hint>
          <required></required>
        </field>
      </row>

      <!-- Filiación Institucional -->
      <row>
        <field>
          <dc-schema>dc</dc-schema>
          <dc-element>description</dc-element>
          <repeatable>true</repeatable>
          <label>Filiación</label>
          <input-type>textarea</input-type>
          <hint>Campo obligatorio si lo tiene el documento. Se debe ingresar la filiación de cada autor. Ej: Pérez, Manuel. Universidad Nacional de Catamarca. Facultad de Tecnología y Ciencias Aplicadas. Departamento de Informática; Argentina. Para DOCUMENTOS INSTITUCIONALES se debe ingresar la siguiente filiación: Universidad Nacional de Catamarca. Facultad de Tecnología y Ciencias Aplicadas; Argentina.</hint>
          <required></required>
        </field>
      </row>

    </form>

    <!-- FORMULARIO PASO 2 (Ex Página 2) REQUERIDO POR DSPACE 8 item-submission.xml -->
    <form name="traditionalpagetwo">

      <!-- Editor -->
      <row>
        <field>
          <dc-schema>dc</dc-schema>
          <dc-element>publisher</dc-element>
          <dc-qualifier></dc-qualifier>
          <repeatable>true</repeatable>
          <label>Editor</label>
          <input-type>onebox</input-type>
          <hint>Obligatorio si lo tiene el documento. Ingrese el nombre del editor de la producción.</hint>
          <required></required>
        </field>
      </row>

      <!-- Director / Colaboradores / Asesores -->
      <row>
        <field>
          <dc-schema>dc</dc-schema>
          <dc-element>contributor</dc-element>
          <dc-qualifier></dc-qualifier>
          <repeatable>true</repeatable>
          <label>Director/ Colaboradores/ Asesores</label>
          <input-type>name</input-type>
          <hint>Obligatorio para tesis de postgrado y trabajos finales. Escribir Apellido, Nombre del Director de la producción</hint>
          <required></required>
        </field>
      </row>

      <!-- Fechas: Publicación y Embargo -->
      <row>
        <field>
          <dc-schema>dc</dc-schema>
          <dc-element>date</dc-element>
          <dc-qualifier>issued</dc-qualifier>
          <repeatable>false</repeatable>
          <label>Fecha de publicación</label>
          <input-type>date</input-type>
          <hint>Campo obligatorio. Por favor indique la fecha de publicación (al menos el año).</hint>
          <required>Debe ingresar al menos el año de la publicación.</required>
        </field>
        <field>
          <dc-schema>dc</dc-schema>
          <dc-element>date</dc-element>
          <dc-qualifier>available</dc-qualifier>
          <repeatable>false</repeatable>
          <label>Fecha de finalización de embargo</label>
          <input-type>date</input-type>
          <hint>Obligatorio si lo tiene el documento. Ingresar la fecha de finalización de embargo.</hint>
          <required></required>
        </field>
      </row>

      <!-- Tipologías Documentales -->
      <row>
        <field>
          <dc-schema>dc</dc-schema>
          <dc-element>type</dc-element>
          <dc-qualifier></dc-qualifier>
          <repeatable>true</repeatable>
          <label>Tipo de resultado científico / Tipo de documento depositado</label>
          <input-type value-pairs-name="common_types">dropdown</input-type>
          <hint>Campo obligatorio * . Seleccionar el tipo de contenido de la producción.</hint>
          <required>Seleccione un valor de la lista.</required>
        </field>
      </row>

      <row>
        <field>
          <dc-schema>dc</dc-schema>
          <dc-element>type</dc-element>
          <dc-qualifier>oa</dc-qualifier>
          <repeatable>true</repeatable>
          <label>Resultado cientifico según OpenAire</label>
          <input-type value-pairs-name="common_types_oa">dropdown</input-type>
          <hint>Tipo de resultado científico según un término basado en el vocabulario controlado de tipos OpenAIRE</hint>
          <required>Seleccione un valor de la lista.</required>
        </field>
      </row>

      <row>
        <field>
          <dc-schema>dc</dc-schema>
          <dc-element>type</dc-element>
          <dc-qualifier>version</dc-qualifier>
          <repeatable>true</repeatable>
          <label>Version de resultado científico</label>
          <input-type value-pairs-name="common_types_version">dropdown</input-type>
          <hint>Consignar la versión del resultado científico</hint>
          <required>Seleccione un valor de la lista.</required>
        </field>
      </row>

      <!-- Identificador y Lenguaje -->
      <row>
        <field>
          <dc-schema>dc</dc-schema>
          <dc-element>identifier</dc-element>
          <repeatable>true</repeatable>
          <label>Identificador del recurso</label>
          <input-type value-pairs-name="common_identifiers">qualdrop_value</input-type>
          <hint>Campo obligatorio si es aplicable. Si la producción tiene un código numérico asociado elegír del combo el tipo de código e ingresarlo.</hint>
          <required></required>
        </field>
        <field>
          <dc-schema>dc</dc-schema>
          <dc-element>language</dc-element>
          <repeatable>false</repeatable>
          <label>Idioma</label>
          <input-type value-pairs-name="common_iso_languages">dropdown</input-type>
          <hint>Campo obligatorio. Seleccionar el lenguaje de la producción de la lista.</hint>
          <required>Seleccione un valor de la lista.</required>
        </field>
      </row>

      <!-- Procedencia Institucional / Evento -->
      <row>
        <field>
          <dc-schema>dc</dc-schema>
          <dc-element>source</dc-element>
          <repeatable>false</repeatable>
          <label>Nombre del Evento/Revista/Carrera de Grado o Posgrado/Dependencia</label>
          <input-type>onebox</input-type>
          <hint>Campo obligatorio si lo tiene el documento. Mencionar nombre del evento científico, revista o nombre de la carrera de grado o posgrado ó dependencia.</hint>
          <required></required>
        </field>
      </row>

      <!-- Relaciones del documento -->
      <row>
        <field>
          <dc-schema>dc</dc-schema>
          <dc-element>relation</dc-element>
          <dc-qualifier>hasversion</dc-qualifier>
          <repeatable>false</repeatable>
          <label>Relación</label>
          <input-type>onebox</input-type>
          <hint>Campo obligatorio si lo tiene el documento. Si posee una versión posterior del trabajo indicar la URL.</hint>
          <required></required>
        </field>
      </row>

      <row>
        <field>
          <dc-schema>dc</dc-schema>
          <dc-element>relation</dc-element>
          <dc-qualifier>uri</dc-qualifier>
          <repeatable>true</repeatable>
          <label>Identificador alternativo</label>
          <input-type>onebox</input-type>
          <hint>Mencionar el link al Objeto Digital fuera del Repositorio.</hint>
          <required></required>
        </field>
      </row>

      <row>
        <field>
          <dc-schema>dc</dc-schema>
          <dc-element>relation</dc-element>
          <dc-qualifier>isbasedon</dc-qualifier>
          <repeatable>true</repeatable>
          <label>Conjunto de datos relacionados</label>
          <input-type>textarea</input-type>
          <hint>Campo obligatorio si lo tiene el documento. Enlaces a los conjuntos de datos primarios.</hint>
          <required></required>
        </field>
      </row>

      <row>
        <field>
          <dc-schema>dc</dc-schema>
          <dc-element>relation</dc-element>
          <repeatable>true</repeatable>
          <label>Identificador de proyecto</label>
          <input-type>textarea</input-type>
          <hint>Campo obligatorio si lo tiene el documento. OrganismoFinanciador/ProgramadeFinanciamiento/CódigodeProyecto/Jurisdicción/NombredelProyecto.</hint>
          <required></required>
        </field>
      </row>

      <!-- Cobertura Espacial / Temporal -->
      <row>
        <field>
          <dc-schema>dc</dc-schema>
          <dc-element>coverage</dc-element>
          <dc-qualifier>temporal</dc-qualifier>
          <repeatable>false</repeatable>
          <label>Cobertura</label>
          <input-type>onebox</input-type>
          <hint>Recomendado. Respetar el siguiente formato: ARG / USA / BRA / COL</hint>
          <required></required>
        </field>
      </row>

      <!-- Derechos y Accesibilidad -->
      <row>
        <field>
          <dc-schema>dc</dc-schema>
          <dc-element>rights</dc-element>
          <dc-qualifier>uri</dc-qualifier>
          <repeatable>false</repeatable>
          <label>Condiciones de uso</label>
          <input-type>textarea</input-type>
          <hint>Escribir el enlace a la licencia Creative Commons correspondiente.</hint>
          <required></required>
        </field>
      </row>

      <row>
        <field>
          <dc-schema>dc</dc-schema>
          <dc-element>rights</dc-element>
          <repeatable>false</repeatable>
          <label>Nivel de accesibilidad</label>
          <input-type value-pairs-name="common_nivel">dropdown</input-type>
          <hint>Información acerca del nivel de acceso al recurso:</hint>
          <required>Seleccione un valor de la lista.</required>
        </field>
      </row>

    </form>

